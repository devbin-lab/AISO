  {
    "type": "function",
    "function": {
      "name": "run_web",
      "description": "Open a workspace HTML file in an isolated local browser and validate runtime errors and requested interactions in one scenario.",
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Workspace-relative path."
          },
          "actions": {
            "type": "array",
            "maxItems": 12,
            "description": "Legacy ordered keyboard actions. Prefer the richer `steps` validation scenario for new checks.",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Keyboard key name."
                },
                "times": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40,
                  "description": "Number of key presses."
                }
              },
              "required": [
                "key"
              ]
            }
          },
          "steps": {
            "type": "array",
            "maxItems": 24,
            "description": "Ordered browser interactions and assertions to run in one local page load, at most 24 steps. Each step is a click, press, wait, or assert.",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string",
                  "enum": [
                    "click",
                    "press",
                    "wait"
                  ]
                },
                "assert": {
                  "type": "string",
                  "enum": [
                    "visible",
                    "text",
                    "state",
                    "canvas_changed",
                    "canvas_unchanged",
                    "no_console_errors"
                  ]
                },
                "by": {
                  "type": "string",
                  "enum": [
                    "role",
                    "testid",
                    "css",
                    "text"
                  ]
                },
                "role": {
                  "type": "string",
                  "description": "Accessibility role."
                },
                "name": {
                  "type": "string",
                  "description": "Accessibility name of the target element."
                },
                "value": {
                  "type": "string",
                  "description": "Test identifier or visible text."
                },
                "selector": {
                  "type": "string",
                  "description": "CSS selector inside the tested page."
                },
                "x_ratio": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Horizontal position inside the target, from 0 to 1."
                },
                "y_ratio": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Vertical position inside the target, from 0 to 1."
                },
                "key": {
                  "type": "string",
                  "description": "Keyboard key name."
                },
                "times": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40,
                  "description": "Number of key presses."
                },
                "ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3000,
                  "description": "Wait duration in milliseconds."
                },
                "path": {
                  "type": "string",
                  "description": "Read-only dotted state path inside the page, such as `window.__AISO_TEST__.state.score`. This is not a file path."
                },
                "equals": {
                  "description": "Expected exact JSON value or text."
                },
                "contains": {
                  "type": "string",
                  "description": "Text that must be present."
                }
              }
            }
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },

          },
          "updated_period": {
            "type": "string",
            "enum": [
              "today",
              "last_24_hours",
              "week",
              "all"
            ],
            "description": "Optional My DB library update period. Use it for reports about items added or changed today."
          },
          "kind": {
            "type": "string",
            "enum": [
              "all",
              "core",
              "file"
            ],
            "description": "My DB item kind to return. Use core when the user asks for core names only."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 240,
            "description": "Maximum number of My DB items to return."
          }
        },
        "additionalProperties": false
      }
    }
  },
